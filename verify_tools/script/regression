def die(msg):
    sys.stderr.write(msg + "\n")
    sys.exit(1)


def format_print(key, value):
    print("%-16s | %s" % (key, value))


def split_time():
    st = time.localtime()
    return (st.tm_sec, st.tm_min, st.tm_hour, st.tm_mday, st.tm_mon, st.tm_year)


def _exists(d, key):
    return key in d


def _defined(d, key):
    return key in d and d[key] is not None


def _system(cmdline):
    return subprocess.call(cmdline, shell=True)


def _popen_lines(cmdline):
    proc = subprocess.Popen(
        cmdline, shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT
    )
    out, _ = proc.communicate()
    if out is None:
        return []
    if isinstance(out, bytes):
        out = out.decode("utf-8", "replace")
    return out.splitlines(True)


def _tool_cmd(name):
    """Prefer sibling script in script_py, then PATH."""
    local = os.path.join(SCRIPT_DIR, name)
    if os.path.isfile(local) and os.access(local, os.X_OK):
        return local
    return name


# ---------------------------------------------------------------------------
# Entry
# ---------------------------------------------------------------------------
def main():
    global cmd_name
    argv_process()
    if cmd_name == "check_lst":
        read_all_list()
    else:
        read_config()
        reload_config()
        run_pre_sim()
        read_all_list()
        reload_proc_num()
        create_dir()
        get_git_info()
        sel_run_mode()


def run_pre_sim():
    pre_sim_cmd = cfg_info.get("PRE_SIM_CMD")
    if not pre_sim_cmd:
        return
    print("Run pre-sim generation: %s" % pre_sim_cmd)
    if subprocess.call(pre_sim_cmd, shell=True, cwd=rsim_dir) != 0:
        die("[python]Pre-sim generation failed")


def reload_proc_num():
    global batch_simrpt_dir, log_abs, run_log_abs
    if "PROC" in input_info:
        cfg_info["PROC"] = input_info["PROC"]
    if int(cfg_info["PROC"]) > run_case_sum:
        cfg_info["PROC"] = run_case_sum
        print("------------------------------------------------------------------------------")
        print("Restore PROC :")
        print("------------------------------------------------------------------------------")
        format_print("PROC", run_case_sum)
    print("------------------------------------------------------------------------------")

    if int(cfg_info.get("SAVE_RPT", 0)) == 1:
        st_sec, st_min, st_hour, st_day, st_mon, st_year = split_time()
        batch_simrpt_dir = "%s/batch_rpt_%s_%s_%s_%s_%s" % (
            rsim_dir, st_year, st_mon, st_day, st_hour, st_min
        )
        log_abs = "%s/%s.log" % (batch_simrpt_dir, cmd_name)
        run_log_abs = "%s/run.log" % batch_simrpt_dir
    else:
        batch_simrpt_dir = os.path.join(sim_dir, "batch_rpt")
        log_abs = "%s/%s.log" % (sim_dir, cmd_name)
        run_log_abs = "%s/run.log" % sim_dir


def create_dir():
    gen_flist()
    if cmd_name == "single":
        create_single_dir()
    else:
        create_public_dir()


def sel_run_mode():
    if input_info.get("CHECK"):
        if cmd_name == "batch":
            for i in range(1, case_sum + 1):
                tmp_name = "tmp0"
                tmp_dir = os.path.join(sim_dir, tmp_name)
                cur_case_name = caselist[i]
                get_compile_path(tmp_dir, cur_case_name)
                build_make_cmd(i, tmp_name, 1)
        elif cmd_name == "recheck":
            for key in batch_keys:
                tmp_name = key
                tmp_dir = os.path.join(sim_dir, tmp_name)
                case_seed, cur_case_num, cur_case_name, cur_loop, cur_loop_times = (
                    get_recheck_info(key)
                )
                get_compile_path(tmp_dir, cur_case_name)
                build_make_cmd(cur_case_num, tmp_name, cur_loop)
        else:
            tmp_name = "sim_single"
            tmp_dir = os.path.join(sim_dir, tmp_name)
            cur_case_num = caselist["case_sum_%s" % case_name]
            get_compile_path(tmp_dir, case_name)
            build_make_cmd(cur_case_num, tmp_name, 1)
    else:
        os.chdir(sim_dir)
        if cmd_name == "batch":
            batch_process()
        elif cmd_name == "recheck":
            recheck_process()
        else:
            single_process()
        gen_dpo_list()


# ---------------------------------------------------------------------------
# single
# ---------------------------------------------------------------------------
def single_process():
    cur_case_num = caselist["case_sum_%s" % case_name]
    info = (cur_case_num, 0, 1, 1)
    if case_name not in caselist:
        die(
            "[python]case name[%s] do not exist.\nPlease check %s before rerun"
            % (case_name, case_list_abs)
        )
    if "SYSC_FLAG" in cfg_info:
        csrc = os.path.join(rsim_dir, "sim_single", "csrc")
        if os.path.exists(csrc):
            _system("rm -rf %s" % csrc)
    sub_cmd_process(sim_dir, cur_case_num, 0, 1, info)


def create_single_dir():
    if not os.path.exists(sim_dir):
        print("Create DIR %s.\n" % sim_dir)
        try:
            os.mkdir(sim_dir, 0o755)
        except OSError as exc:
            die("[python]Cannot make '%s' directiory\n:%s" % (sim_dir, exc))
    link_file(sim_dir)


def get_single_cmd():
    if int(input_info.get("SIM_ONLY", 0)) == 1:
        return "make sim "
    if int(input_info.get("COMPILE_ONLY", 0)) == 1:
        return "make compile "
    return "make "


# ---------------------------------------------------------------------------
# batch
# ---------------------------------------------------------------------------
def batch_process():
    create_batch_process()
    summarize_report()
    coverage_report()
    summarize_report_to_screen()


def gen_dpo_list():
    if "DPO" in input_info and int(input_info["DPO"]) == 1:
        input_info["lst"] = case_list_name
        list_files = case_list_name.split("+")
        learn_dpo = os.path.join(rsim_dir, "..", "rsim", "learn_dpo")
        for lst in list_files:
            out_case_list_abs = "./a"
            in_abs = os.path.join(rsim_dir, "case_lst", lst)
            dpo_abs = os.path.join(rsim_dir, "case_lst", "dpo_%s" % lst)
            try:
                in_fh = open(in_abs, "r")
            except IOError:
                die('[python]Missing file: "%s"' % in_abs)
            try:
                out_fh = open(out_case_list_abs, "w")
            except IOError:
                die('[python]Missing file: "%s"' % out_case_list_abs)
            for line in in_fh:
                line = line.rstrip("\n")
                out_fh.write(line + "\n")
                if not re.match(r"^\s*(#|//)", line):
                    m = re.search(r"case_name\s*=\s*(\S+)", line)
                    if m:
                        out_fh.write(
                            "  cmp_full       = -dpo_opts learn_dbdir=%s/%s\n"
                            % (learn_dpo, m.group(1))
                        )
            in_fh.close()
            out_fh.close()
            _system("mv %s %s" % (out_case_list_abs, dpo_abs))


def create_batch_process():
    global regression_log_fh
    print("-------------------------------------------")
    print("\tRegression begin: PROC=%s" % cfg_info["PROC"])
    print("-------------------------------------------")
    try:
        regression_log_fh = open(log_abs, "a")
    except IOError as exc:
        die("[python] cannot open %s\n:%s" % (log_abs, exc))

    zombie = [0]
    proc_num = 0

    def _on_chld(signum, frame):
        zombie[0] += 1

    import signal

    signal.signal(signal.SIGCHLD, _on_chld)

    for i in range(int(cfg_info["PROC"])):
        pid = os.fork()
        proc_num += 1
        if proc_num % 20 == 0:
            time.sleep(1)
        if pid == 0:
            sub_batch_process("tmp%d" % i, case_sum)
            os._exit(0)

    while zombie[0] < int(cfg_info["PROC"]):
        time.sleep(5)

    while zombie[0] > 0:
        try:
            os.waitpid(-1, os.WNOHANG)
        except OSError:
            pass
        zombie[0] -= 1


def sub_batch_process(tmp_name, total_case_num):
    tmp_dir = os.path.join(sim_dir, tmp_name)
    try:
        os.mkdir(tmp_dir, 0o755)
    except OSError as exc:
        die("[python]Cannot make '%s' directory\n:%s" % (tmp_dir, exc))
    link_file(tmp_dir)
    os.chdir(tmp_dir)

    while True:
        cur_case_num, cur_loop, loop_times = case_pointer(total_case_num)
        if cur_case_num > total_case_num:
            break
        if loop_times > 0:
            sub_process(tmp_dir, cur_case_num, tmp_name, cur_loop, loop_times)
            log_collection(tmp_dir, cur_case_num, cur_loop, loop_times)


def get_batch_cmd(cur_case_name, cur_tmp_name):
    for_fast = 0
    define_cmp = 0
    new_define = None
    key_def = "vcs_tb_defines_%s" % cur_case_name
    if key_def in caselist:
        new_define = caselist[key_def]
        define_cmp = 1

    if cur_tmp_name in dir_define:
        if define_cmp:
            if new_define == dir_define.get("vcs_tb_defines_%s" % cur_tmp_name):
                for_fast = 1
        else:
            if dir_define.get("vcs_tb_defines_%s" % cur_tmp_name, None) == "":
                for_fast = 1

    if define_cmp:
        dir_define["vcs_tb_defines_%s" % cur_tmp_name] = new_define
    else:
        dir_define["vcs_tb_defines_%s" % cur_tmp_name] = ""

    if cur_tmp_name in dir_define:
        dir_define[cur_tmp_name] += 1
    else:
        dir_define[cur_tmp_name] = 1

    if for_fast and int(cfg_info.get("FAST", 0)) == 1:
        return "make sim "
    return "make "


# ---------------------------------------------------------------------------
# recheck
# ---------------------------------------------------------------------------
def recheck_process():
    create_recheck_process()
    summarize_report()
    summarize_report_to_screen()


def create_recheck_process():
    global regression_log_fh
    print("-------------------------------------------")
    print("\tRegression begin:")
    print("-------------------------------------------")
    try:
        regression_log_fh = open(log_abs, "a")
    except IOError as exc:
        die("[python] cannot open %s\n:%s" % (log_abs, exc))

    zombies = [0]
    num_proc = [0]
    num_collect = 0

    def _on_chld(signum, frame):
        zombies[0] += 1
        num_proc[0] -= 1

    import signal

    signal.signal(signal.SIGCHLD, _on_chld)

    for key in batch_keys:
        pid = os.fork()
        if pid == 0:
            sub_recheck_process(key)
            os._exit(0)
        num_proc[0] += 1
        while num_proc[0] >= int(cfg_info["PROC"]):
            time.sleep(5)
        if zombies[0] > 0:
            while True:
                try:
                    collect = os.waitpid(-1, os.WNOHANG)
                except OSError:
                    break
                if collect[0] <= 0:
                    break
                num_collect += 1

    while (fail_case_sum - num_collect) > 0:
        try:
            collect = os.waitpid(-1, os.WNOHANG)
        except OSError:
            time.sleep(0.1)
            continue
        if collect[0] > 0:
            num_collect += 1
        else:
            time.sleep(0.1)


def get_recheck_info(batch_key):
    m = re.match(r"(\d+)_(\S+)_(\d+)_(\d+)", batch_key)
    cur_case_num = int(m.group(1))
    cur_case_name = m.group(2)
    cur_loop = int(m.group(3))
    cur_loop_times = int(m.group(4))
    case_seed = batch_log[
        "%s_%s_%s_%s" % (cur_case_num, cur_case_name, cur_loop, cur_loop_times)
    ]
    caselist["seed_%s" % cur_case_name] = case_seed
    return case_seed, cur_case_num, cur_case_name, cur_loop, cur_loop_times


def sub_recheck_process(batch_key):
    tmp_name = batch_key
    case_seed, cur_case_num, cur_case_name, cur_loop, cur_loop_times = get_recheck_info(
        batch_key
    )
    tmp_dir = os.path.join(sim_dir, tmp_name)
    try:
        os.mkdir(tmp_dir, 0o755)
    except OSError as exc:
        die("[python]Cannot make '%s' directory\n:%s" % (tmp_dir, exc))
    link_file(tmp_dir)
    os.chdir(tmp_dir)
    sub_process(tmp_dir, cur_case_num, tmp_name, cur_loop, cur_loop_times)


def sub_process(tmp_dir, cur_case_num, tmp_name, cur_loop, cur_loop_times):
    info = (cur_case_num, tmp_name, cur_loop, cur_loop_times)
    st_time = print_time(info, "BEGIN")
    make_cmd, case_seed, case_result = sub_cmd_process(
        tmp_dir, cur_case_num, tmp_name, cur_loop, info
    )
    re_run_times, re_case_result = re_run_check(
        make_cmd, case_seed, case_result, tmp_dir, info
    )
    end_time = print_time(info, "END")
    print_result_to_file(
        re_run_times, case_seed, re_case_result, st_time, end_time, info
    )


def sub_cmd_process(tmp_dir, cur_case_num, tmp_name, cur_loop, info):
    cur_case_name = caselist[cur_case_num]
    make_cmd = None
    case_seed = -1
    case_result = get_compile_path(tmp_dir, cur_case_name)
    if int(input_info.get("PROGRAM_ONLY", 0)) == 0:
        if re.search(r"\bpass\S*", str(case_result)):
            make_cmd = build_make_cmd(cur_case_num, tmp_name, cur_loop)
            case_seed, case_result = exe_and_check(
                make_cmd, -1, "fail", tmp_dir, info
            )
    return make_cmd, case_seed, case_result


def read_bacth_log():
    global batch_keys, fail_case_sum, run_case_sum
    print("-------------------------------------------")
    print("\tThe batch fail case :")
    print("-------------------------------------------")
    try:
        fh = open(batch_log_abs, "r")
    except IOError:
        die('[python]Missing file: "%s"' % batch_log_abs)

    for line in fh:
        m = re.search(r"(\S+)\s+(\S+)\S*\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)", line)
        if m:
            case, cur_case_name_raw, seed, rslt = m.group(2), m.group(3), m.group(4), m.group(6)
            if re.search(r"\bfail\S*", rslt):
                num_m = re.search(r"^case([0-9]+)", case)
                num = num_m.group(1)
                name_m = re.search(r"\[(\S+)\]\((\d+)/(\d+)", cur_case_name_raw)
                cur_case_name = name_m.group(1)
                loop = name_m.group(2)
                loop_times = name_m.group(3)
                seed_m = re.search(r"seed=(\d+)", seed)
                seed = seed_m.group(1)
                print(
                    "case%s_%s(%s/%s): %s :%s"
                    % (num, cur_case_name, loop, loop_times, seed, rslt)
                )
                batch_log["%s_%s_%s_%s" % (num, cur_case_name, loop, loop_times)] = seed
    fh.close()
    batch_keys = sorted(batch_log.keys())
    fail_case_sum = len(batch_keys)
    run_case_sum = fail_case_sum
    print("Fail case sum: %s " % fail_case_sum)
    print("")


