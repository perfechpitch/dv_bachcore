def get_main_file(cur_tmp_dir, cur_case_name):
    fail = 0
    soft = caselist["soft_name_%s" % cur_case_name]
    _system(
        "find %s -name %s | awk -F '/[^/]*.$' '{ print $1 }' | uniq > %s"
        % (cfg_info["VMEM_DIR"], soft, compile_list_abs)
    )
    try:
        fh = open(compile_list_abs, "r")
    except IOError:
        if cmd_name == "single":
            die('[python]Missing file: "%s"' % compile_list_abs)
        return 1
    file_num = 0
    save_path = None
    for line in fh:
        if file_num > 0:
            if cmd_name == "single":
                die(
                    "[python]soft_name[%s] is not alone.\nPlease check %s"
                    % (soft, compile_list_abs)
                )
            fail = 1
        save_path = line.rstrip("\n")
        file_num += 1
    fh.close()
    try:
        open("%s/%s" % (save_path, soft), "r").close()
        print("get %s" % soft)
        _system("cp %s/%s %s/main.bin" % (save_path, soft, cur_tmp_dir))
    except (IOError, TypeError):
        if cmd_name == "single":
            die(
                "[python]ERROR:no such %s/%s!!!!!!!!!!!" % (save_path, soft)
            )
        fail = 1
    return fail


def risc_soft_compile(cur_tmp_dir, cur_case_name):
    fail = 0
    soft = caselist["soft_name_%s" % cur_case_name]
    _system("find %s -name %s > %s" % (case_dir, soft, compile_list_abs))
    if not os.path.exists(compile_list_abs):
        if cmd_name == "single":
            die("[python]Missing file: %s" % compile_list_abs)
        return 1
    if os.path.getsize(compile_list_abs) == 0:
        if cmd_name == "single":
            die("[python]ERROR: NO SUCH CASE: %s" % soft)
        return 1
    compile_cnt = 0
    fh = open(compile_list_abs, "r")
    for line in fh:
        compile_cnt += 1
        if compile_cnt > 1:
            if cmd_name == "single":
                die(
                    "[python]soft program name[%s] is not alone.\nPlease check %s and change one program_name before rerun"
                    % (soft, compile_list_abs)
                )
            fail = 1
        fail = build_risc_make_compile(line.rstrip("\n"), cur_tmp_dir, cur_case_name)
    fh.close()
    _system("rm %s" % compile_list_abs)
    return fail


def gen_risc_compile_cmd(save_path, cur_tmp_dir, cur_case_name):
    global soft_case_name, soft_case_dir
    soft = caselist["soft_name_%s" % cur_case_name]
    m = re.match(r"(\S*)\.\S+", soft)
    if m:
        soft_case_name = m.group(1)
    cmd_line = None
    vmem_name = None
    m = re.match(r"(.*)/(\w+)\.\S+\s*$", save_path)
    if m:
        soft_case_dir = m.group(1)
        dir_name = None
        dm = re.search(r"stest/(\w+)", soft_case_dir)
        if dm:
            dir_name = dm.group(1)
        gcc_dir = str(cfg_info.get("GCC_DIR", ""))
        addr_mode = caselist["addr_mode_%s" % cur_case_name]
        if re.search(r".*xxx.*", gcc_dir):
            if addr_mode == 1:
                cmd_line = (
                    "RISCV_PREFIX=riscv64-linux- make -C target_files -f %s/%s/stest/Makefile "
                    "src_dir=%s/%s/stest home_dir=%s XLEN=64 %s-p-%s.vmem >> 1"
                    % (
                        rsim_dir,
                        cfg_info["TEST_DIR"],
                        rsim_dir,
                        cfg_info["TEST_DIR"],
                        gcc_dir,
                        dir_name,
                        soft_case_name,
                    )
                )
            else:
                cmd_line = (
                    "RISCV_PREFIX=riscv64-linux- make -C target_files -f %s/%s/stest/Makefile "
                    "src_dir=%s/%s/stest home_dir=%s XLEN=64 %s-v-%s.vmem >> 1"
                    % (
                        rsim_dir,
                        cfg_info["TEST_DIR"],
                        rsim_dir,
                        cfg_info["TEST_DIR"],
                        gcc_dir,
                        dir_name,
                        soft_case_name,
                    )
                )
        else:
            if addr_mode == 1:
                cmd_line = (
                    "make -C target_files -f %s/Makefile stest tests=%s-p-%s "
                    "target_dir=%s/%s >> 1"
                    % (
                        gcc_dir,
                        dir_name,
                        soft_case_name,
                        rsim_dir,
                        cfg_info["TEST_DIR"],
                    )
                )
            else:
                cmd_line = (
                    "make -C target_files -f %s/Makefile stest tests=%s-v-%s "
                    "target_dir=%s/%s >> 1"
                    % (
                        gcc_dir,
                        dir_name,
                        soft_case_name,
                        rsim_dir,
                        cfg_info["TEST_DIR"],
                    )
                )
        if addr_mode == 1:
            vmem_name = "%s-p-%s.vmem" % (dir_name, soft_case_name)
        else:
            vmem_name = "%s-v-%s.vmem" % (dir_name, soft_case_name)

    if input_info.get("CHECK") and run_log_fh is not None:
        run_log_fh.write("%s\n" % cmd_line)
        run_log_fh.flush()
    return vmem_name, cmd_line


def build_risc_make_compile(save_path, cur_tmp_dir, cur_case_name):
    vmem_name, cmd_line = gen_risc_compile_cmd(save_path, cur_tmp_dir, cur_case_name)
    fail = 0
    if not input_info.get("CHECK"):
        _system("rm -rf target_files")
        try:
            os.mkdir("target_files", 0o755)
        except OSError:
            pass
        if not os.path.exists("target_files"):
            if cmd_name == "single":
                die("[python]Cannot make 'target_files' directiory")
            fail = 1
        gcc_dir = str(cfg_info.get("GCC_DIR", ""))
        if not re.search(r".*xxx.*", gcc_dir):
            _system(
                "make -C target_files -f %s/Makefile %s >> 1"
                % (gcc_dir, caselist["gcc_config_%s" % cur_case_name])
            )
        _system(cmd_line)
        try:
            open("target_files/stest/%s" % vmem_name, "r").close()
        except IOError:
            if cmd_name == "single":
                die(
                    "[python]ERROR: %s/%s compile fail !!!!!!!!!!!"
                    % (soft_case_dir, caselist["soft_name_%s" % cur_case_name])
                )
            fail = 1
        if not fail:
            _system(
                "cp ./target_files/stest/%s %s/test.vmem"
                % (vmem_name, cur_tmp_dir)
            )
    return fail


def get_compile_path(cur_tmp_dir, cur_case_name):
    case_result = PASS
    if str(caselist.get("random_mode_%s" % cur_case_name, 1)).find("0") >= 0:
        if int(input_info.get("COMPILE_ONLY", 0)) == 0:
            os.chdir(cur_tmp_dir)
            fail = get_boot_file(cur_tmp_dir, cur_case_name)
            if fail:
                case_result = "fail(Miss boot file)"
            else:
                fail = get_system_file(cur_tmp_dir, cur_case_name)
                if fail:
                    case_result = "fail(Miss system file)"
                else:
                    soft = caselist["soft_name_%s" % cur_case_name]
                    if re.search(r"\w+\.vmem", soft):
                        tmp_log = os.path.join(cur_tmp_dir, "tmp.log")
                        _system(
                            "find %s  -name %s > %s"
                            % (cfg_info["VMEM_DIR"], soft, tmp_log)
                        )
                        try:
                            fh = open(tmp_log, "r")
                        except IOError:
                            if cmd_name == "single":
                                die('[python]Missing file: "%s"' % tmp_log)
                            return "fail(Miss file)"
                        file_num = 0
                        save_path = None
                        for line in fh:
                            if file_num > 0:
                                if cmd_name == "single":
                                    die(
                                        "[python]soft_name[%s] is not alone.\nPlease check %s"
                                        % (soft, tmp_log)
                                    )
                                case_result = "fail(%s is not alone)" % soft
                            save_path = line.rstrip("\n")
                            file_num += 1
                        fh.close()
                        if save_path and os.path.exists(save_path):
                            _system(
                                "cp %s %s/test.vmem" % (save_path, cur_tmp_dir)
                            )
                        else:
                            if cmd_name == "single":
                                die("[python]:can not find %s" % soft)
                            case_result = "fail(Miss soft file)"
                    elif re.search(r"\w+\.bin", soft):
                        fail = get_main_file(cur_tmp_dir, cur_case_name)
                        if fail:
                            case_result = "fail(Miss soft file)"
                    elif re.search(r"\w+\.\S+", soft):
                        fail = risc_soft_compile(cur_tmp_dir, cur_case_name)
                        if fail:
                            case_result = "fail(program compile err)"
    return case_result


def summarize_report():
    global fail_cnt, pass_cnt, err, regression_log_fh, run_log_fh
    if regression_log_fh is not None:
        regression_log_fh.close()
        regression_log_fh = None
    if run_log_fh is not None:
        run_log_fh.close()
        run_log_fh = None

    try:
        fh = open(log_abs, "r")
    except IOError as exc:
        die("[python] cannot open %s\n:%s" % (log_abs, exc))

    result_list = {}
    for line in fh:
        m = re.search(r".*case(\d+)\s\[(\S+)\]\((\d+).(\d+)", line)
        if m:
            result_list["%s%s%s%s" % (m.group(1), m.group(2), m.group(3), m.group(4))] = (
                line
            )
        else:
            die("[python] cannot match case info in 'batch.log'")
        m = re.search(r":\s(\S+)", line)
        if m:
            if re.search(r"\bfail\S*", m.group(1)):
                fail_cnt += 1
            elif m.group(1) == "pass":
                pass_cnt += 1
            else:
                die("[python] cannot match pass/fail string in 'batch.log'")
    fh.close()

    keys = sorted(result_list.keys())
    t = time_elapse()
    try:
        out = open(log_abs, "w")
    except IOError as exc:
        die("[python] cannot open %s\n:%s" % (log_abs, exc))
    for k in keys:
        out.write(result_list[k])

    err = run_case_sum - pass_cnt - fail_cnt
    out.write("\n-------------------------------------------\n")
    out.write("\t\tSUMMURIZE REPORT\n")
    out.write("-------------------------------------------\n")
    out.write(
        "Total : %s\nPass  : %s\nFail  : %s\nUnRun: %s\n"
        % (run_case_sum, pass_cnt, fail_cnt, err)
    )
    out.write("Time elapse: %s:%s:%s\n" % (t[0], t[1], t[2]))
    out.write("-------------------------------------------\n")
    out.write("cmd: %s\n" % cmd)
    out.write("-------------------------------------------\n")
    print("-------------------------------------------")
    print("\tRegression end!!!")
    print("-------------------------------------------")
    out.close()


def summarize_report_to_screen():
    t = time_elapse()
    print("\n-------------------------------------------")
    print("\t\tSUMMURIZE REPORT")
    print("-------------------------------------------")
    print(
        "Total : %s\nPass  : %s\nFail  : %s\nUnRun: %s"
        % (run_case_sum, pass_cnt, fail_cnt, err)
    )
    print("Time elapse: %s:%s:%s" % (t[0], t[1], t[2]))
    print("-------------------------------------------")
    print("CMD   : %s" % cmd)
    print("-------------------------------------------")


def time_elapse():
    global batch_end_time
    batch_end_time = time.time()
    delta_time = int(batch_end_time - batch_start_time)
    minutes = int(delta_time / 60)
    sec = delta_time % 60
    hor = int(minutes / 60)
    minutes = minutes % 60
    return (hor, minutes, sec)


def coverage_report():
    if "COV" in cfg_info and int(cfg_info["COV"]) == 1:
        os.chdir(sim_dir)
        print("-------------------------------------------")
        print("\tCoverage report generate:")
        print("-------------------------------------------")
        vdb_dir_collection = ""
        for dir_num in range(int(cfg_info["PROC"]) - 1, -1, -1):
            tmp_name = "tmp%d" % dir_num
            tmp_dir = os.path.join(sim_dir, tmp_name)
            if os.path.exists(tmp_dir):
                vdb_dir_collection += "%s/simv.vdb " % tmp_dir
            else:
                die("[python]Missing dir %s" % tmp_dir)
        if vdb_dir_collection:
            print(vdb_dir_collection)
            print("")
            if "MAP" in cfg_info:
                _system(
                    "urg -full64 -dir %s -dbname batch_cov.vdb -format text "
                    "-report batch_cov_report.txt -map %s"
                    % (vdb_dir_collection, cfg_info["MAP"])
                )
            else:
                _system(
                    "urg -full64 -dir %s -dbname batch_cov.vdb -format text "
                    "-report batch_cov_report.txt" % vdb_dir_collection
                )


if __name__ == "__main__":
    main()
