################################################################
#  case_name       | null    | necessary 
#  uvm_tc          | null    | necessary 
#  base_case       | null    | optional  it will get uvm_tc,vcs_tb_defines,vcs_tb_args of base_case
#  soft_name       | null    | necessary when run asm/c program,others optional ##ddr     #can be used to appoint test_file
#  gcc_config      | null    | necessary when run asm/c program,others optional           #can be used to compile c/asm program in fixed mode 
#  batch_times     | 1       | optional
#  vcs_tb_defines  | null    | optional
#  vcs_tb_args     | null    | optional,"+" split args
#  cmp_full        | null    | optional,-sv_root $path/tensor_core -av_lib libC
#  sim_full        | null    | optional,-sv_root $path/tensor_core -av_lib libC
#  seed            | null    | optional
#  performance_log | 0       | optional,if you want collect "PERFORMANCE_LOG....."
################################################################
- case_name      = 1
  uvm_tc         = mu_test
