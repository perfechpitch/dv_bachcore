# ==============================================================================
# Simulation working directories
#
# These directories contain generated compilation, simulation, waveform,
# coverage and regression files.
# Applicable to UT / BT / IT / ST environments at any directory depth.
# ==============================================================================

**/rsim/sim_single/
**/rsim/sim_batch/
**/rsim/sim_recheck/


# ==============================================================================
# Python generated files
# ==============================================================================

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/


# ==============================================================================
# Editor generated files
# ==============================================================================

.vscode/
.idea/
*.swp
*.swo
*~


# ==============================================================================
# Operating system generated files
# ==============================================================================

.DS_Store
Thumbs.db


# ==============================================================================
# Temporary files
# ==============================================================================

*.tmp
*.bak
*.orig


# ==============================================================================
# Imported UVM component generated files
# ==============================================================================

# Local simulation/build output and historical installation snapshots.
st/sim_rtl/uvm_tb/axi4_vip_adapter/work/
st/sim_rtl/uvm_tb/axi4_vip_adapter/backup/
st/sim_rtl/uvm_tb/memory_backdoor/work/

# Transfer/editor artifacts that are not part of either component.
._*
.~lock.*#
st/sim_rtl/uvm_tb/axi4_vip_adapter/1
st/sim_rtl/uvm_tb/memory_backdoor/1
