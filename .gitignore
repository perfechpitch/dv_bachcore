################################################################################
# dv_bachcore .gitignore
################################################################################

# ==============================================================================
# Simulation working directories
#
# These directories contain generated compilation, simulation, waveform,
# coverage and regression files.
# Applicable to UT / BT / IT / ST environments at any directory depth.
# ==============================================================================

**/rsim/sim_single/
**/rsim/sim_batch/
**/rsim/sim_recheck/

# Non-standard simulation directory names use the same generated layout.
/st/sim_rtl/rsim_rvcore/sim_single/
/st/sim_rtl/rsim_rvcore/verdiLog/


# ==============================================================================
# Python generated files
# ==============================================================================

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/


# ==============================================================================
# Editor generated files
# ==============================================================================

.vscode/
.idea/
*.swp
*.swo
*~
.nfs*


# ==============================================================================
# Operating system generated files
# ==============================================================================

.DS_Store
Thumbs.db


# ==============================================================================
# Temporary files
# ==============================================================================

*.tmp
*.bak
*.orig

# ==============================================================================
# Third-party CMake build artifacts
# ==============================================================================

verify_tools/vip/formal/softvector/softfloat/build/
verify_tools/vip/formal/softvector/softfloat/install/

# ==============================================================================
# Pre-sim and agent-sim generated outputs
# ==============================================================================

/st/pre_sim/output/
**/rsim/case_lst/_pre_sim_*.lst
**/rsim/flist_*.f
/st/sim_rtl/rsim_rvcore/flist_*.f
**/rsim/uvm_home/

# Local rollback snapshots and per-user Bug Tool data.
/st/sim_rtl/bench/dut_dummy/*.before_*
/st/pre_sim/generator/inst_generator/bug_db/

# Core Reference generated runtime
/st/core_ref/ref_sim/sim_single/
/st/core_ref/ref_sim/flist_core_ref.f

# Per-user Bug DB clones (separate Git repositories or symlinks)
/st/core_ref/bug_db
/st/sim_rtl/bug_db
