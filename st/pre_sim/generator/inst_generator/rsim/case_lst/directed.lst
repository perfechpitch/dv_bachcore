#---------------------multi-core directed scenario
# PRE_SIM_SCENE_BEGIN multicore_directed_test
# scene_id: 1
# seq_file: directed/workload/multicore_directed_scenario_seq.sv
# supported_plusargs: <none>
- case_name      = multicore_directed_test
  uvm_tc         = directed_inst_test
  vcs_tb_args    = +directed_seq_name=multicore_directed
  batch_times    = 1
# PRE_SIM_SCENE_END multicore_directed_test

- case_name      = directed_test
  uvm_tc         = directed_inst_test
  vcs_tb_args    = +directed_seq_name=multicore_directed
  batch_times    = 1

