 #---------------------seq_debug test
 - case_name      = jalr_seq_test
   uvm_tc         = seq_debug_test
   vcs_tb_args    = +test_mode=INT_TEST+program_mode=M_MODE+debug_seq_name=jalr_seq
 
 - case_name      = branch_inst_disable_ls_test
   uvm_tc         = seq_debug_test
   vcs_tb_args    = +test_mode=INT_TEST+program_mode=M_MODE+debug_seq_name=branch_inst_seq+global_disable_ls
 
 - case_name      = ls_base_config_test
   uvm_tc         = seq_debug_test
   vcs_tb_args    = +test_mode=INT_TEST+program_mode=M_MODE+debug_seq_name=ls_base_config_seq
 
 - case_name      = ls_inst_test
   uvm_tc         = seq_debug_test
   vcs_tb_args    = +test_mode=INT_TEST+debug_seq_name=ls_inst_seq
- case_name      = except_inst_test
   uvm_tc         = seq_debug_test
   vcs_tb_args    = +test_mode=INT_TEST+debug_seq_name=except_inst_seq+except_disable=0+support_compress_design
