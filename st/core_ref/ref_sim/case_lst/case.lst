# VMEM selection:
#   vcs_tb_args = +MEM_INIT0=<vmem_name>
# VMEM files are resolved under ref_sim/src_file/; the default is test.vmem.
# Multiple VMEM files can be overlaid with:
#   vcs_tb_args = +MEM_INIT0=<first.vmem>+MEM_INIT1=<second.vmem>

- case_name      = single_vu
  uvm_tc         = test
  batch_times    = 1

- case_name      = single_mu
  uvm_tc         = test
  vcs_tb_args    = +CORE_DSA_TYPE=MU
  batch_times    = 1

- case_name      = single_dte
  uvm_tc         = test
  vcs_tb_args    = +CORE_DSA_TYPE=DTE
  batch_times    = 1

- case_name      = multi_core
  uvm_tc         = test
  vcs_tb_args    = +CORE_NUM=3
  batch_times    = 1
